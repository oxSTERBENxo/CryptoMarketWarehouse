POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_market_warehouse
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change_me

# Shown on the Warehouse Health page only (e.g. "development"/"staging"/"production") -- purely
# informational, never used to change app behavior.
ENVIRONMENT=development

# Single timezone authority for "what calendar date is today", used by startup gap-detection
# (see startup_recovery.py) and the manual snapshot's intraday observation timestamp. Defaults to
# UTC, matching how the rest of the pipeline already behaves.
APP_TIMEZONE=UTC

# Automated historical data collection (see README "Scheduler" section).
# Disabled by default so tests and ad-hoc `uvicorn` runs never start a background job unasked.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=60
# Optional: pipeline parameters used by scheduled/manual runs (defaults match the CLI scripts).
SCHEDULER_CURRENCY=usd
SCHEDULER_LIMIT=100
SCHEDULER_ORDER=market_cap_desc

# Intraday ("Today" chart) collection is a separate, optional job -- disabled by default so
# enabling ENABLE_SCHEDULER above never silently adds extra CoinGecko traffic. One call per coin
# per run against /coins/{id}/market_chart, independent of the daily pipeline above.
ENABLE_INTRADAY_SCHEDULER=false
INTRADAY_INTERVAL_MINUTES=60
INTRADAY_COINS=bitcoin,ethereum,solana,cardano,dogecoin

# Comma-separated list of origins allowed to call this API (CORS). Defaults to the common Vite
# dev server ports (5173-5175, localhost + 127.0.0.1) if unset. Add your deployed frontend's
# origin(s) here in production, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Starting cash balance (USD) for the paper-trading account, created lazily on first use.
# Simulated only — no real money is ever involved.
PAPER_TRADING_INITIAL_CASH=100000.00

# AI analysis subsystem. Select which provider get_ai_provider() builds; every AI feature keeps
# using the same backend interface, so switching between local Ollama and Groq only requires env
# changes.
AI_PROVIDER=ollama

# Ollama-specific settings, only read when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

# Groq-specific settings, only read when AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60
